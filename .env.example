# Configuracion del Agente Empresarial Seguro.
# Copia este archivo como .env y ajusta los valores. NO subas .env al repositorio.

# Endpoint de Ollama. Debe ser loopback; cualquier otro host es rechazado.
OLLAMA_HOST=http://127.0.0.1:11434

# Modelo local por defecto (debe estar descargado: ollama pull qwen2.5-coder:7b).
OLLAMA_MODEL=qwen2.5-coder:7b

# Workspace permitido (copia local del proyecto, nunca un recurso de red).
# AGENT_WORKSPACE=C:\trabajo\proyecto-copia

# Directorio de bitacoras de auditoria. Fuera del repositorio a proposito.
# AGENT_AUDIT_DIR=C:\trabajo\auditoria-agente

# --- Base de datos LOCAL (perfil 'datos'; NUNCA produccion) ---
# Usuario de MySQL local. Por defecto: root.
# AGENT_DB_USER=root
# Contrasena de MySQL local. Se pasa al cliente por variable de entorno,
# nunca en la linea de comandos ni en la bitacora.
# AGENT_DB_PASSWORD=
